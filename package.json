{
  "name": "flowsnap",
  "version": "1.0.0",
  "description": "Autonomous UI Action Recorder & Intelligent SOP Synthesizer",
  "main": "src/recorder.mjs",
  "bin": {
    "flowsnap": "./bin/flowsnap.mjs",
    "flowsnap-mcp": "./bin/flowsnap-mcp.mjs"
  },
  "type": "module",
  "scripts": {
    "start": "node ./bin/flowsnap.mjs start",
    "mcp": "node ./bin/flowsnap-mcp.mjs",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "help": "node ./bin/flowsnap.mjs --help",
    "setup-agent": "node ./bin/flowsnap.mjs setup-agent",
    "test": "node scripts/validate.mjs",
    "test:unit": "node --test test/config.test.mjs test/generator.test.mjs test/ai_enhancer.test.mjs test/mcp.test.mjs test/installer.test.mjs",
    "test:all": "node --test test/*.test.mjs",
    "test:preflight": "node -e \"import('./src/preflight.mjs').then(m => m.checkPlaywright())\"",
    "validate": "node scripts/validate.mjs"
  },
  "keywords": [
    "scribe-alternative",
    "sop-generator",
    "action-recorder",
    "playwright",
    "documentation",
    "workflow-capture"
  ],
  "author": "Lutfi Majid & Antigravity",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.40.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  }
}
